# Salin file ini menjadi .env dan isi dengan nilai yang sebenarnya
# Copy this file to .env and fill in the actual values

# Token Bot Discord (wajib diisi)
TOKEN_DISCORD=your_discord_bot_token_here

# Prefix command bot (default: !)
PREFIX=!

# ID Channel yang diizinkan menggunakan bot
ALLOWED_CHANNEL_ID=your_channel_id_here

# ID Role yang diizinkan menggunakan bot
ALLOWED_ROLE_ID=your_role_id_here
